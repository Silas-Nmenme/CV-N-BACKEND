# ---------------------------------------------------------------------------
# CV GADGETS configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000
# Public address of the site, no trailing slash. Used for payment callbacks and emails.
APP_URL=https://www.your-domain.ng

# MongoDB (Atlas connection string or your own server)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/cv_gadgets?retryWrites=true&w=majority

# Long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_DAYS=14

# Set to 1 when running behind Nginx, Render, Railway, Heroku etc. so client IPs and HTTPS are detected correctly.
TRUST_PROXY=1
# Extra origins allowed to call the API with cookies (leave empty for a single-domain site)
ALLOWED_ORIGINS=

# --- First administrator (used by `npm run seed` / `npm run create-admin`) ---
ADMIN_NAME=Store Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Paystack (https://dashboard.paystack.com > Settings > API Keys & Webhooks) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Flutterwave (https://dashboard.flutterwave.com > Settings > API) ---
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
# The "Secret hash" you type into Settings > Webhooks on the Flutterwave dashboard
FLW_SECRET_HASH=

# --- Email (order confirmations, password resets). Any SMTP provider works. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CV GADGETS <no-reply@your-domain.ng>

# --- Image storage. Leave Cloudinary empty to store images on the server disk (UPLOAD_DIR). ---
UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Order holds ---
# Minutes an unpaid card/online order keeps its stock reserved before being released
PENDING_ORDER_MINUTES=60
# Hours a bank-transfer order keeps its stock reserved
BANK_TRANSFER_HOLD_HOURS=24
